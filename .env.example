# Copy to .env. Never commit .env.
#
# With ANTHROPIC_API_KEY empty and LLM_PROVIDER unset, the app uses the
# offline qualifier so the simulator works before you have a key.
# To answer with Claude instead:
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_PROVIDER=

# simulated (default) stores replies locally. whatsapp calls the Cloud API.
MESSAGING_PROVIDER=simulated

# Must match the verify token you type in the Meta webhook form.
WHATSAPP_VERIFY_TOKEN=horizon-sample-verify
# Permanent token and phone number id from the WhatsApp product in your Meta app.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App secret from the Meta app. When set, POST /webhook must be signed.
WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_VERSION=v21.0

# Optional. Defaults to data/travel.db. The Docker image uses /data/travel.db
# unless you uncomment the next line (which would override the image default).
# SQLITE_PATH=data/travel.db
