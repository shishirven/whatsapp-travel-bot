# Copy to .env. Never commit .env.
#
# With ANTHROPIC_API_KEY empty and LLM_PROVIDER unset, the app uses the
# offline qualifier so the simulator works before you have a key.
# To answer with Claude instead:
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_PROVIDER=

# OpenAI Whisper transcribes inbound WhatsApp voice notes.
# Leave empty to keep voice notes on the job without a transcript.
OPENAI_API_KEY=
# WHISPER_MODEL=whisper-1

# simulated (default) stores replies locally. whatsapp calls the Cloud API.
MESSAGING_PROVIDER=simulated

# Must match the verify token you type in the Meta webhook form.
# VERIFY_TOKEN is the name Render uses. WHATSAPP_VERIFY_TOKEN is accepted too.
VERIFY_TOKEN=tradie-verify
# Permanent token from the WhatsApp product in your Meta app.
WHATSAPP_TOKEN=
# Phone number id. PHONE_NUMBER_ID or WHATSAPP_PHONE_NUMBER_ID.
PHONE_NUMBER_ID=
# App secret from the Meta app. When set, POST /webhook must be signed
# with X-Hub-Signature-256. APP_SECRET or WHATSAPP_APP_SECRET.
APP_SECRET=
# WHATSAPP_GRAPH_VERSION=v21.0

# Staff desk login. Leave both empty only on your own machine.
# Set both on Render before the URL is shared.
STAFF_USERNAME=
STAFF_PASSWORD=
# STAFF_SESSION_SECRET=

# Google Calendar. Use a service account JSON string, or a credentials file,
# or an OAuth refresh token. Leave all empty to book into the local database
# only (the simulator). Share the calendar with the service account email.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/google.json
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=

# Trade, suburbs, job types, hours, and draft price bands.
# BUSINESS_CONFIG=config/business.json

# Optional. Defaults to data/tradie.db. The Docker image uses /data/tradie.db
# unless you uncomment the next line (which would override the image default).
# SQLITE_PATH=data/tradie.db
